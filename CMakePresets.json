{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "wch",
      "displayName": "WCH CH585 RISC-V",
      "description": "Cross build for the WCH CH585 using the MounRiver/WCH GCC toolchain",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/riscv-wch-toolchain.cmake",
      "cacheVariables": {
        "WCH_DEBUG_UART": "1",
        "WCH_DCDC_ENABLE": "ON",
        "WCH_BLE_ENABLE": "ON",
        "WCH_RF_ENABLE": "ON",
        "WCH_LOG_LEVEL": "LOG_LVL_ERROR"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wch",
      "configurePreset": "wch"
    }
  ]
}
